{
  "name": "keith",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run deps && bun run plans --lint && bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "deps": "bun scripts/check-deps.ts",
    "plans": "bun scripts/plans.ts",
    "dev": "bun --watch packages/core/src/cli/main.ts start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2"
  }
}
