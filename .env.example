KEITH_DATA_DIR=./data
KEITH_PORT=7420
KEITH_LOG_LEVEL=info
# Nodes: URL a node uses to reach this core (join command of /pair); default http://localhost:<port>
# KEITH_PUBLIC_URL=http://100.64.0.1:7420
# The in-process node "core" may run shell.exec (the owner still approves each command)
# KEITH_CORE_ALLOW_SHELL=false

# Model providers: a key here becomes a read-only connection (otherwise add one with /connect)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
